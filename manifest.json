{
  "manifest_version": 3,
  "name": "AliExpress Photo Downloader",
  "description": "Adiciona botões para baixar imagens de produtos no AliExpress.",
  "version": "1.0.0",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.alicdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
