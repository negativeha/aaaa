{
  "manifest_version": 3,
  "name": "AliExpress Photo Downloader",
  "description": "Baixe fotos de produtos do AliExpress por hover ou pelo popup da extensão.",
  "version": "1.1.0",
  "permissions": [
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://*.alicdn.com/*"
  ],
  "action": {
    "default_title": "AliExpress Photo Downloader",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
